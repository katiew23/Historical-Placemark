{{> menu}}

<section class="section">
  <div class="level">
    <div class="level-left">
      <h1 class="title">{{collection.title}}</h1>
    </div>
    <div class="level-right">
      <a href="/dashboard/deletecollection/{{collection._id}}" class="button is-danger is-small">
        Delete Collection
      </a>
    </div>
  </div>

  {{> collection-image}}

  <!-- map -->
  <div id="collectionMap"></div>

  {{> add-placemark collectionId=collection._id}}

  <h3 class="subtitle">Placemarks in this Collection</h3>

  {{#each placemarksByCategory}}

    <h3 class="subtitle">{{@key}}</h3>

    <ul>
      {{#each this}}
  <li style="margin-bottom: 10px;">
    <strong>{{name}}</strong>
    <span style="color:#888">({{category}})</span> –
    {{description}} –
    ({{latitude}}, {{longitude}})

    <a href="/collection/{{../../collection._id}}/editplacemark/{{_id}}"
       class="button is-small is-warning"
       style="margin-left: 10px;">
       Edit
    </a>

    <a href="/collection/{{../../collection._id}}/deleteplacemark/{{_id}}"
       class="button is-small is-danger"
       style="margin-left: 5px;">
       🗑
    </a>
  </li>
{{/each}}
    </ul>

  {{/each}}

</section>

<style>
  #collectionMap {
    width: 100%;
    height: 400px;
    margin-bottom: 2em;
  }

  @media (max-width: 768px) {
    #collectionMap {
      height: 250px;
    }
  }
</style>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.3/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.3/dist/leaflet.js"></script>

<script>
  const placemarks = {{{placemarksJson}}};

  const map = L.map('collectionMap').setView([53.1424, -7.6921], 7);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap contributors'
  }).addTo(map);

  const markers = [];

  placemarks.forEach(function(place) {

    if (place.latitude && place.longitude) {

      const popupContent = `
        <div style="min-width:150px">
          <strong>${place.name}</strong><br>
          <small style="color:#666">${place.category || "Uncategorised"}</small><br>
          ${place.description || ""}
        </div>
      `;

      const marker = L.marker([place.latitude, place.longitude])
        .addTo(map)
        .bindPopup(popupContent);

      markers.push(marker);
    }

  });

  if (markers.length > 0) {
    const group = L.featureGroup(markers);
    map.fitBounds(group.getBounds().pad(0.2));
  }
</script>