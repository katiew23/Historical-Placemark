{{> welcome-menu}}

<section class="section">
  <div class="container">

    <div class="columns is-vcentered is-centered">

      <!-- Welcome Text -->
      <div class="column is-half has-text-centered">
        <h1 class="title">Historical Placemark</h1>
        <p class="subtitle">
          Explore and organise places of historical interest.
        </p>

        <p class="mb-5">
