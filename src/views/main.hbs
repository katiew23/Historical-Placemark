      </div>

      <!-- Image -->
      <div class="column is-half has-text-centered">
        <img 
          src="/images/reginalds.jpg" 
          alt="Historical Placemark Image" 
          class="welcome-logo"
          style="max-width: 350px; border-radius: 10px;"
        >
      </div>

    </div>

  </div>
