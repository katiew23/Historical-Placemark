{{#each playlist.placemarks}}
  <tr>
    <td>{{title}}</td>
    <td>{{pointOfInterest}}</td>
    <td>{{latitude}}</td>
    <td>{{longitude}}</td>
    <td>
      <a
        href="/collection/{{../playlist._id}}/deleteplacemark/{{_id}}"
        class="button is-danger is-small"
      >
        Delete
      </a>
    </td>
  </tr>
{{/each}}
